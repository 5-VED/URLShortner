model User {
  id         String   @id @default(uuid())
  email      String   @unique
  firstName  String
  lastName   String
  password   String
  phoneNo    String?
  profilePic String?
  role       String?
  isDeleted  Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  urls       URL[]
}